# ─── Grevidea Gateway Environment Variables ───────────────────────────────────

# Supabase PostgreSQL connection string
# Format: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.YOURREF:YOURPASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# GCI Brain (Python FastAPI) — internal only
BRAIN_URL=http://localhost:8000

# JWT secret — change in production!
JWT_SECRET=change-this-to-a-long-random-secret-in-production

# Gateway port
GATEWAY_PORT=3000

# AQI APIs (optional — OpenAQ works without a key)
CPCB_API_KEY=
OPENAQ_API_KEY=

# FCM (add later when Firebase project is ready)
FCM_SERVER_KEY=

# Outbound partner relays. Each must implement docs/integration-completion.md.
# Never point test traffic at real emergency dispatch or live fulfillment.
SOS_RELAY_URL=
SOS_RELAY_TOKEN=
MUNICIPAL_RELAY_URL=
MUNICIPAL_RELAY_TOKEN=
FULFILLMENT_RELAY_URL=
FULFILLMENT_RELAY_TOKEN=
# Shared HMAC secret exchanged with relays for signed receipts; >=32 random bytes.
DELIVERY_CALLBACK_SECRET=

# Normalized official authority feed. Optional token for your approved feed adapter.
HAZARD_FEED_URL=
HAZARD_FEED_TOKEN=
HAZARD_FEED_NAME=

# Override with production-capacity services. Public demo routers have usage limits.
OSRM_ROUTER_BASE=https://router.project-osrm.org/route/v1/driving
WALK_ROUTER_BASE=https://routing.openstreetmap.de/routed-foot/route/v1/foot
OVERPASS_URL=https://overpass-api.de/api/interpreter
FLOOD_API_URL=https://flood-api.open-meteo.com/v1/flood
# Keep false outside isolated disposable tests.
ALLOW_LOCAL_TEST_PROVIDERS=false

# Normalized, fresh municipal/OpenAQ station adapter for route exposure scoring.
AQI_STATION_FEED_URL=
AQI_STATION_FEED_TOKEN=
