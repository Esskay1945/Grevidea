# ─── Grevidea Gateway Environment Variables ───────────────────────────────────

# Supabase PostgreSQL connection string
# Format: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.YOURREF:YOURPASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# GCI Brain (Python FastAPI) — internal only
BRAIN_URL=http://localhost:8000

# JWT secret — change in production!
JWT_SECRET=change-this-to-a-long-random-secret-in-production

# Gateway port
GATEWAY_PORT=3000

# AQI APIs (optional — OpenAQ works without a key)
CPCB_API_KEY=
OPENAQ_API_KEY=

# FCM (add later when Firebase project is ready)
FCM_SERVER_KEY=
