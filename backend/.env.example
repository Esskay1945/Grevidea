# Run the Brain from backend/. No real secrets belong in git.
PORT=8000
AXUM_GATEWAY_URL=http://127.0.0.1:3000
GEMINI_ENABLED=true
GEMINI_API_KEY=
# Choose a model currently available for your Google account.
GEMINI_MODEL=
GROQ_ENABLED=true
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
MISTRAL_API_KEY=
TAVILY_API_KEY=
OPENALEX_API_KEY=
# Path to 11 research papers for AI corpus grounding (bundled in grevidea/Research Papers)
RESEARCH_PDF_DIR=../grevidea/Research Papers
