# Grevidea Flutter Frontend Environment Configuration
# Flutter passes variables at build/run time via --dart-define flags.

# Base URL pointing to the Axum API Gateway (Port 3000)
# - Web local development: http://localhost:3000
# - Android Emulator: http://10.0.2.2:3000
# - Physical Android device: http://<LAN-IP>:3000 or https://api.yourdomain.com
API_BASE_URL=http://localhost:3000

# WebSocket Base URL for real-time live events & push updates
# - Web local: ws://localhost:3000/api/v1/live
# - Android Emulator: ws://10.0.2.2:3000/api/v1/live
WS_BASE_URL=ws://localhost:3000/api/v1/live

# Example Run Commands:
# flutter run -d chrome --dart-define=API_BASE_URL=http://localhost:3000
# flutter run -d android --dart-define=API_BASE_URL=http://10.0.2.2:3000
# flutter build apk --release --dart-define=API_BASE_URL=https://api.grevidea.app
# flutter build web --release --dart-define=API_BASE_URL=https://api.grevidea.app
